{
  "name": "math-formula-parser",
  "description": "TypeScript parser for complex mathematical formulas into Abstract Syntax Trees (AST)",
  "license": "MIT",
  "version": "0.1.0",
  "author": {
    "name": "komed3 (Paul Köhler)",
    "email": "webmaster@komed3.de",
    "url": "https://komed3.de"
  },
  "homepage": "https://github.com/komed3/math-formula-parser",
  "keywords": [
    "mathematics",
    "parser",
    "formula",
    "ast",
    "expression",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/komed3/math-formula-parser.git"
  },
  "bugs": {
    "url": "https://github.com/komed3/math-formula-parser/issues"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/komed3"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "types": "./dist/types/index.d.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "browser": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.min.js",
  "unpkg": "./dist/index.umd.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.cjs",
      "default": "./dist/index.umd.js"
    }
  },
  "scripts": {
    "build": "rollup -c && tsc --emitDeclarationOnly --declarationDir dist/types && prettier --write \"dist/**/*.{mjs,cjs,js}\""
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "esbuild": "^0.27.4",
    "prettier": "^3.8.1",
    "rollup": "^4.60.0",
    "rollup-plugin-esbuild": "^6.2.1",
    "typescript": "^6.0.2"
  }
}
